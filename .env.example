# Neon Postgres connection string (auto-provided by Neon Vercel integration)
DATABASE_URL=postgresql://user:password@host/dbname

# Secret for signing JWT auth cookies — use a long random string
JWT_SECRET=your_super_secret_jwt_key_here_change_this

# Google Gemini API key (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

PORT=3001
NODE_ENV=development

# Frontend URL for CORS (set to your Vercel deployment URL in production)
CLIENT_ORIGIN=http://localhost:5173

# Registration gate. ASCII only. Case-sensitive. Avoid ambiguous chars (O/0, l/1).
# Leave unset or empty to disable in dev.
INVITE_CODE=your-secret-invite-code

# Vercel Blob access token (auto-provided by Vercel Blob integration)
BLOB_READ_WRITE_TOKEN=your_blob_token_here
