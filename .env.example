# Groq API key — default AI provider (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Spoonacular recipe search API key (https://spoonacular.com/food-api, free tier, no credit card)
SPOONACULAR_API_KEY=your_spoonacular_api_key_here

# Google Gemini API key — retained as quota-exhaustion fallback (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Secret for signing JWT auth cookies — use a long random string
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

PORT=3001
NODE_ENV=development

# Frontend URL for CORS (set to your Vercel deployment URL in production)
CLIENT_ORIGIN=http://localhost:5173

# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host/dbname

# VAPID keys for Web Push notifications
# Generate: node -e "import('web-push').then(m => { const k = m.default.generateVAPIDKeys(); console.log('PUBLIC:', k.publicKey); console.log('PRIVATE:', k.privateKey); })"
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:you@yourdomain.com

# Registration gate — leave unset or empty to disable
INVITE_CODE=your-secret-invite-code

# Vercel Blob access token (auto-provided by Vercel Blob integration)
BLOB_READ_WRITE_TOKEN=your_blob_token_here

# Resend email service — required for household invite emails (https://resend.com)
# Leave RESEND_API_KEY unset to disable email (POST /api/household/invite returns 503)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=you@yourdomain.com

# AES-256-GCM encryption secret for BYOK household AI keys (TASK-012)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: never change this value after first use — all stored keys will become undecryptable
API_KEY_ENCRYPTION_SECRET=your_32_byte_hex_secret_here
