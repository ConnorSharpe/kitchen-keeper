# OpenAI API key — default AI provider (https://platform.openai.com)
# IMPORTANT: Set a monthly spending cap in the OpenAI dashboard before use
OPENAI_API_KEY=your_openai_api_key_here

# Spoonacular recipe search API key (https://spoonacular.com/food-api, free tier, no credit card)
SPOONACULAR_API_KEY=your_spoonacular_api_key_here

PORT=3001
NODE_ENV=development

# Frontend URL for CORS (set to your Vercel deployment URL in production)
CLIENT_ORIGIN=http://localhost:5173

# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host/dbname

# VAPID keys for Web Push notifications
# Generate: node -e "import('web-push').then(m => { const k = m.default.generateVAPIDKeys(); console.log('PUBLIC:', k.publicKey); console.log('PRIVATE:', k.privateKey); })"
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:you@yourdomain.com

# Vercel Blob access token (auto-provided by Vercel Blob integration)
BLOB_READ_WRITE_TOKEN=your_blob_token_here

# Resend email service — required for household invite emails (https://resend.com)
# Leave RESEND_API_KEY unset to disable email (POST /api/household/invite returns 503)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=you@yourdomain.com

# Clerk authentication (https://clerk.com — free tier, 10k MAU)
# Verify current package names at docs.clerk.com before installing
CLERK_SECRET_KEY=sk_live_your_clerk_secret_key_here
VITE_CLERK_PUBLISHABLE_KEY=pk_live_your_clerk_publishable_key_here

# AES-256-GCM encryption key for stored OpenAI BYOK keys (TASK-016B)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: never change this value after first use — all stored keys become undecryptable
ENCRYPTION_KEY=your_64_char_hex_string_here

# Connor's Clerk user ID — identifies the owner household (uses platform OPENAI_API_KEY)
# Set after signing up via Clerk. Found in Clerk Dashboard → Users.
# All other households must supply their own OpenAI key (BYOK).
OWNER_CLERK_ID=user_your_clerk_user_id_here
